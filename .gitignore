# ============================================================
#  vps_router — .gitignore (публичный репозиторий)
#  Главное правило: НИКАКИХ секретов, ключей, БД и локального окружения.
# ============================================================

# --- Секреты и данные (НИКОГДА не коммитить) ------------------
# Реальный конфиг с app_secret и путями. В репозитории только шаблон:
#   panel/config.php.example
config.php
panel/config.php
/etc/panel/config.php

# База данных панели (SQLite) + WAL/SHM
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
panel.db

# Приватные ключи, сертификаты, preshared-ключи
*.key
*.pem
*.pfx
*.p12
*.psk
id_rsa*
*_rsa
*.ppk

# Резервные копии настроек панели (содержат app_secret и зашифрованные ключи!)
*backup*.json
settings-export*.json
*.backup

# --- Локальное окружение --------------------------------------
.env
.env.*
*.local

# --- Зависимости ----------------------------------------------
vendor/
/panel/vendor/
node_modules/

# --- Временное / тесты / логи ---------------------------------
.phpunit.result.cache
/panel/.phpunit.result.cache
/panel/.devrun/
/panel/.test-tmp/
*.log
*.tmp

# --- IDE / редакторы ------------------------------------------
.idea/
.vscode/
*.iml
*.sublime-*

# --- Инструменты Claude Code (локальное состояние) ------------
.claude/

# --- Внутренняя документация / черновики (не публикуется) -----
# Публикуется только README.md; всё остальное внутреннее — вне репозитория.
/docs/
/TODO.md
/instruction.txt
/HOWTO.php
/info.txt

# --- ОС -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
