# Установка: скопировать в /etc/sudoers.d/panel-provision, права 440, владелец root:root.
# Проверить синтаксис перед применением: visudo -cf /etc/sudoers.d/panel-provision
#
# Отдельная запись от panel-apply (не расширяем её) — устанавливает пакеты,
# а не только перезапускает уже настроенные сервисы, поэтому держим её как
# явно отдельное, легко отзываемое разрешение.
# www-data может выполнить ТОЛЬКО этот один скрипт, без аргументов и без пароля.
www-data ALL=(root) NOPASSWD: /usr/local/sbin/vpsrouter-vps-install.sh
